# 이 파일을 .env 로 복사한 뒤 받은 키만 채우세요. 없는 줄은 비워 두면 됩니다.
# (비워 둔 공급자는 litellm.config.yaml 에서 해당 블록을 주석 처리해야 합니다)

# Claude Code 가 프록시에 낼 비밀번호(아무 문자열). claude-free.sh 와 같아야 합니다.
LITELLM_MASTER_KEY=sk-free-local

GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
NVIDIA_API_KEY=          # https://build.nvidia.com  (Developer Program 가입)
ZAI_API_KEY=             # https://z.ai  (국제판)  또는 https://open.bigmodel.cn
OLLAMA_API_KEY=          # https://ollama.com/settings/keys
COHERE_API_KEY=          # https://dashboard.cohere.com/api-keys
KILO_API_KEY=            # https://app.kilo.ai/profile  (무료 키)
